# Managed by Ansible (roles/controlclaw/templates/Caddyfile-mitm.j2). Do not edit on the box.
#
# Caddy on the FIREWALL box. It exists for two things: inbound webhooks (controlclaw
# docs/plans/webhooks.md) and signing browsers in to the org's agents (controlclaw
# docs/plans/browser-enrollment.md). It terminates TLS for this firewall's own hostname with a
# Let's Encrypt certificate (HTTP-01, relayed by the proxy box on port 80, exactly as an agent
# box's is) and hands /hook/*, /__cc/open and /__cc/enroll/confirm to the mitm-agent's ingress
# listener on loopback.
#
# The reachable surface of a firewall box is precisely what this file serves, so it has to stay
# small: one path prefix, two exact POST routes that answer with a status or a redirect and never
# a page, Team chat behind the mitm-agent's cookie check, the website logins page, and a bare 404 for everything else. No admin endpoint, no file server, no directory
# listing, no OpenClaw, no noVNC — none of those exist on this box.
{
    email {{ caddy_acme_email }}
    # Issuers are explicit and tried in this order: Let's Encrypt, then ZeroSSL. Every box still
    # gets a certificate of its own for its own name, with its own key. The second issuer exists
    # because Let's Encrypt allows 50 new certificates per registered domain per week, and on
    # 2026-09-29 test boxes on the production domain used that up: every new box after it had no
    # certificate at all. ZeroSSL's ACME endpoint gets its account binding from the email above.
    cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
    cert_issuer acme https://acme.zerossl.com/v2/DV90
    # Nothing on this box needs Caddy's admin API, and it listens on loopback by default. A
    # firewall box holds the org's secrets; it does not get a second control surface.
    admin off
}

{{ vm_hostname }}{% if cc_handle_alias | default('') and cc_handle_alias != vm_hostname %}, {{ cc_handle_alias }}{% endif %} {
    handle /phone-stream/* {
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

    handle /hook/* {
        # The ingress caps the body itself, because an HMAC is computed over the whole of it and
        # the check has to see the same bytes. This is the outer bound, so a stranger cannot make
        # Caddy buffer more than the ingress would ever accept.
        request_body {
            max_size {{ ingress_max_body }}
        }
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

    # Open, through the firewall (browser-enrollment.md §3). A form POST from an agent's own page:
    # an open intent and a binding, or a pending id and a code. Both fit in a few hundred bytes.
    # Exact paths, not prefixes, so nothing else under /__cc/ reaches the mitm-agent.
    handle /__cc/doctor/* {
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

    @access path /__cc/open /__cc/enroll/confirm /__cc/meetings/media
    handle @access {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

{% if disk_encryption | default(false) | bool %}
    # A firewall whose encrypted disk has not been opened. This is the box the console tells an owner to
    # unlock FIRST — open it and every agent follows from its tang within the minute — so it needs a way
    # in that does not depend on the mitm-agent, whose keys are inside the container.
    #
    # It is also the only inbound path this box has that the control plane did not previously have: a
    # firewall is otherwise unreachable from us by design, and it reports outbound instead. What is
    # added is two routes that hold no secret (see the agent Caddyfile's comment for why neither needs a
    # bearer) and exist only while the disk is shut — cc-secure-daemon stops listening the moment it
    # opens. docs/plans/disk-encryption.md §5.1.
    handle /__cc/disk/* {
        uri strip_prefix /__cc/disk
        reverse_proxy 127.0.0.1:{{ luks_locked_port | default(3101) }}
    }

{% endif %}
    # Website logins (controlclaw docs/plans/website-credentials.md): the page an owner or admin types
    # a login into, served by the mitm-agent behind its own cookie and an enrolled browser. A login is
    # a few hundred bytes; the bound leaves room for a CSV import later and nothing more.
    handle /__cc/logins/* {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

    # Team chat's own routes: the page that opens it from the console, and Caddy's question below.
    handle /__cc/team-chat/* {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:{{ ingress_port }}
    }

    # Everything else is Team chat (ClickClack, loopback {{ clickclack_port | default(3931) }}), and
    # only for a browser the mitm-agent let in: forward_auth asks /__cc/team-chat/verify, which
    # answers 200 for a live team chat cookie while Team chat is on, and a bare 404 otherwise — so
    # for anyone else, including /, this is still a bare 404 with no body, and a probe learns
    # nothing about whether this box exists or what it runs.
    handle {
        forward_auth 127.0.0.1:{{ ingress_port }} {
            uri /__cc/team-chat/verify
        }
        reverse_proxy 127.0.0.1:{{ clickclack_port | default(3931) }}
    }
}
