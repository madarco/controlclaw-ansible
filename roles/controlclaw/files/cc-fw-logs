#!/usr/bin/python3
"""Firewall logs (controlclaw apps/saas/docs/features/firewall-logs.md): the one root helper the
mitm-agent may run to read this box's own service journals and its last update run.

Granted by one sudoers line (tasks/mitmbox.yml). It only reads. The units are fixed here: the caller
picks one of the names below or `all`, never a unit, a path or a journalctl option. Numbers are
clamped. Secrets are masked by the mitm-agent before anything leaves the box (src/fw-redact.ts).

  cc-fw-logs journal <since-seconds> <max-lines> <service|all>
                      journalctl -o json for those units, newest <max-lines> in the window
  cc-fw-logs run      the last update or provisioning run: /var/log/ansible-pull.log from the
                      offset cc-reprovision saved when that run started (the whole tail when there
                      is none, which on a box never updated is its first provisioning)
"""
import os
import re
import sys

# The service names are the contract with packages/mitm-agent/src/fw-logs.ts (FW_SERVICES).
SERVICES = {
    "mitm-agent": ["controlclaw-mitm-agent.service"],
    "proxy": ["controlclaw-mitmproxy.service"],
    "caddy": ["caddy.service"],
    "dnsmasq": ["dnsmasq.service"],
    "tang": ["tangd.socket"],
    "disk": ["cc-secure.service"],
    "team-chat": ["clickclack.service"],
    "chrony": ["chrony.service"],
    "tailscale": ["tailscaled.service"],
    "update": ["cc-reprovision.service"],
}
# Template units that start one instance per connection, read through their slice instead of by
# unit name. Tang runs a tangd@<n>-<addr>:<port>.service for every key request, so a firewall that
# has been up a week has tens of thousands of instance names in its journal. `journalctl -u
# 'tangd@*.service'` turns that glob into matches for every one of them (about 17 ms each), and a
# read took minutes; the slice is one match. systemd's own lines about an instance carry no slice,
# so the two that matter, a main process that exited and a unit that failed, are matched by their
# message ids; the mitm-agent drops the ones about units outside its list.
INSTANCE_SLICES = {"tang": "system-tangd.slice"}
SYSTEMD_EXITED = "98e322203f7a4ed290d09fe03c09fe15"
SYSTEMD_FAILED = "d9b373ed55a64feb8242e02dbe79a49c"
FIELDS = "MESSAGE,PRIORITY,_SYSTEMD_UNIT,UNIT,SYSLOG_IDENTIFIER,_PID"
LOG = "/var/log/ansible-pull.log"
START = "/opt/controlclaw/state/update-log-start"
RUN_LINES = 2000
# A run's log is a few hundred KiB at most; anything larger is read from its last 4 MiB.
RUN_BYTES = 4 * 1024 * 1024


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(2)


def number(value, high):
    if not re.fullmatch(r"[0-9]{1,7}", value or ""):
        fail("invalid number")
    return max(1, min(int(value), high))


def matches(names):
    """journalctl match terms for these services, OR-ed with `+`: what `-u` adds for each unit
    (its own lines, systemd's lines about it, coredumps), plus each instance slice."""
    groups = []
    for name in names:
        for unit in SERVICES[name]:
            groups += [[f"_SYSTEMD_UNIT={unit}"], [f"UNIT={unit}", "_PID=1"], [f"OBJECT_SYSTEMD_UNIT={unit}", "_UID=0"], [f"COREDUMP_UNIT={unit}", "_UID=0"]]
        if name in INSTANCE_SLICES:
            groups += [[f"_SYSTEMD_SLICE={INSTANCE_SLICES[name]}"], [f"MESSAGE_ID={SYSTEMD_EXITED}", "_PID=1"], [f"MESSAGE_ID={SYSTEMD_FAILED}", "_PID=1"]]
    out = []
    for group in groups:
        if out:
            out.append("+")
        out += group
    return out


def journal(args):
    if len(args) != 3:
        fail("usage: cc-fw-logs journal <since-seconds> <max-lines> <service|all>")
    since = number(args[0], 86400)
    lines = number(args[1], 5000)
    if args[2] == "all":
        names = list(SERVICES)
    elif args[2] in SERVICES:
        names = [args[2]]
    else:
        fail("unknown service")
    cmd = ["journalctl", "--no-pager", "-o", "json", f"--output-fields={FIELDS}", f"--since=-{since}s", "-n", str(lines)] + matches(names)
    os.execvp(cmd[0], cmd)


def run(args):
    if args:
        fail("usage: cc-fw-logs run")
    try:
        size = os.path.getsize(LOG)
    except OSError:
        return
    start = 0
    try:
        with open(START) as f:
            value = f.read().strip()
        if re.fullmatch(r"[0-9]{1,15}", value) and int(value) <= size:
            start = int(value)
    except OSError:
        pass
    cut = size - RUN_BYTES > start
    start = max(start, size - RUN_BYTES)
    with open(LOG, "rb") as f:
        f.seek(start)
        data = f.read()
    # Cut at 4 MiB, so the first line is a partial one: drop it.
    if cut:
        data = data[data.find(b"\n") + 1:]
    tail = data.split(b"\n")[-RUN_LINES - 1:]
    sys.stdout.buffer.write(b"\n".join(tail))


def main():
    if len(sys.argv) < 2:
        fail("usage: cc-fw-logs journal|run ...")
    if sys.argv[1] == "journal":
        return journal(sys.argv[2:])
    if sys.argv[1] == "run":
        return run(sys.argv[2:])
    fail("unknown command")


if __name__ == "__main__":
    main()
