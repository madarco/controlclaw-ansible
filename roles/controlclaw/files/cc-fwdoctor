#!/usr/bin/python3
"""What a Firewall Doctor session's coding agent runs to look at and repair the firewall.

No privilege of its own: it posts the command to the mitm-agent on loopback with this session's
token (CC_FWDOCTOR_URL, CC_FWDOCTOR_TOKEN, set by cc-doctor-run), and prints the answer. The
mitm-agent decides what runs. `cc-fwdoctor help` lists the commands.
"""
import json
import os
import sys
import urllib.error
import urllib.request

url, token = os.environ.get("CC_FWDOCTOR_URL", ""), os.environ.get("CC_FWDOCTOR_TOKEN", "")
if not url.startswith("http://127.0.0.1:") or not token:
    sys.stderr.write("cc-fwdoctor works only inside a Firewall Doctor session.\n")
    sys.exit(2)
args = sys.argv[1:] or ["help"]
if len(args) > 3:
    sys.stderr.write("Too many arguments. Run: cc-fwdoctor help\n")
    sys.exit(2)
body = {"verb": args[0]}
if len(args) > 1:
    body["arg"] = args[1]
if len(args) > 2:
    body["extra"] = args[2]
request = urllib.request.Request(url + "/run", data=json.dumps(body).encode(), method="POST",
                                 headers={"authorization": "Bearer " + token, "content-type": "application/json"})
try:
    with urllib.request.urlopen(request, timeout=180) as response:
        answer = json.loads(response.read())
except urllib.error.HTTPError as error:
    try:
        answer = json.loads(error.read())
    except ValueError:
        answer = {"ok": False, "text": "Refused (" + str(error.code) + ")."}
except (urllib.error.URLError, TimeoutError, ValueError):
    answer = {"ok": False, "text": "The firewall did not answer. If an update was started, this session has ended."}
print(answer.get("text", ""))
sys.exit(0 if answer.get("ok") else 1)
