#!/usr/bin/python3
"""Narrow root broker. All CLI execution is in a bounded ccdoctor systemd unit."""
import fcntl, ipaddress, json, math, os, pwd, re, subprocess, sys, time
from pathlib import Path
BASE = Path('/run/ccdoctor')
ALLOWED_ENV = {'ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN', 'ANTHROPIC_BASE_URL', 'OPENAI_API_KEY', 'OPENAI_BASE_URL', 'AI_GATEWAY_API_KEY', 'CC_DOCTOR_OPENAI_ACCOUNT_ID', 'CC_FWDOCTOR_URL', 'CC_FWDOCTOR_TOKEN'}
def write(path, data, uid, gid):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as out:
        os.fchown(out.fileno(), uid, gid)
        out.write(data)
def main():
    if os.geteuid() != 0 or len(sys.argv) != 4: raise ValueError()
    sid, cli, mode = sys.argv[1:]
    if not re.fullmatch(r'[a-zA-Z0-9_-]{8,80}', sid) or cli not in ('claude','codex','pi') or mode not in ('chat','terminal'): raise ValueError()
    raw = sys.stdin.buffer.read(131073)
    if len(raw) > 131072: raise ValueError()
    data = json.loads(raw)
    env = data['env']
    if not isinstance(env, dict) or not env or any(k not in ALLOWED_ENV or not isinstance(v,str) or len(v)>16384 or '\0' in v or '\n' in v for k,v in env.items()): raise ValueError()
    # Firewall Doctor repairs this box through cc-fwdoctor: no SSH key, no agent, a loopback tool URL.
    firewall = data.get('target') == 'firewall'
    if firewall:
        if data.get('sshPrivateKey') or not re.fullmatch(r'http://127\.0\.0\.1:[0-9]{1,5}', env.get('CC_FWDOCTOR_URL','')) or not env.get('CC_FWDOCTOR_TOKEN'): raise ValueError()
        ip, name = 'firewall', 'the firewall'
    else:
        if 'CC_FWDOCTOR_URL' in env or 'CC_FWDOCTOR_TOKEN' in env: raise ValueError()
        key = data['sshPrivateKey']
        if not isinstance(key,str) or len(key)>8192 or not key.startswith('-----BEGIN OPENSSH PRIVATE KEY-----'): raise ValueError()
        agent = data['agent']
        ip = ipaddress.ip_address(agent['privateIp'])
        if not ip.is_private or ip.is_loopback or ip.is_link_local: raise ValueError()
        vmid = agent['vmId']
        if not isinstance(vmid,str) or not re.fullmatch(r'[a-zA-Z0-9_-]{1,80}',vmid): raise ValueError()
        name = 'agent-'+vmid
        hostkey = agent['sshHostKey']
        if not re.fullmatch(r'ssh-ed25519 [A-Za-z0-9+/=]{68}(?: [^\r\n]+)?', hostkey): raise ValueError()
    for field, cap in [('model',256), ('problem',32768), ('resumeId',256)]:
        if field in data and (not isinstance(data[field],str) or len(data[field])>cap or '\0' in data[field]): raise ValueError()
    seconds = data.get('seconds',7200)
    if not isinstance(seconds,(int,float)) or not math.isfinite(seconds) or not 1 <= seconds <= 7200: raise ValueError()
    account = pwd.getpwnam('ccdoctor')
    BASE.mkdir(mode=0o711, exist_ok=True)
    work = BASE / sid
    lock = os.open(BASE / (sid+'.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    fcntl.flock(lock,fcntl.LOCK_EX)
    metadata = BASE / (sid+'.json')
    now = time.time()
    if metadata.exists():
        old = json.loads(metadata.read_text())
        if old.get('ended') or old['cli'] != cli or old['agent'] != str(ip) or now >= old['deadline']: raise ValueError()
        seconds = min(seconds, old['deadline'] - now)
    else:
        # Parent is root-owned: ccdoctor cannot replace this directory with a symlink.
        work.mkdir(mode=0o700)
        os.chown(work,account.pw_uid,account.pw_gid)
        write(metadata,json.dumps({'cli':cli,'agent':str(ip),'deadline':now+seconds}),0,0)
        subprocess.run(['/usr/bin/systemd-run','--quiet','--unit=cc-doctor-expire-'+sid,'--on-active='+str(math.ceil(seconds))+'s','/usr/local/bin/cc-doctor-stop',sid],check=True)
    # Refuse overlapping turns. The firewall pauses before switching modes.
    active = subprocess.run(['/usr/bin/systemctl','is-active','--quiet','cc-doctor-'+sid+'.service']).returncode == 0
    if active: raise ValueError()
    subprocess.run(['/usr/bin/systemctl','reset-failed','cc-doctor-'+sid+'.service'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if firewall:
        write(work/'AGENTS.md',FIREWALL_INSTRUCTIONS,account.pw_uid,account.pw_gid)
    else:
        write_agent_files(work,account,ip,name,key,hostkey)
    alias = work/'CLAUDE.md'
    if not alias.exists() and not alias.is_symlink(): alias.symlink_to('AGENTS.md')
    data.update({'env':env,'mode':mode,'cli':cli})
    data.pop('sshPrivateKey',None)
    write(work/'request.json',json.dumps(data),account.pw_uid,account.pw_gid)
    return launch(sid,work,mode,seconds,lock)

def write_agent_files(work,account,ip,name,key,hostkey):
    write(work/'key',key,account.pw_uid,account.pw_gid)
    write(work/'known_hosts',f'{ip} {hostkey}\n',account.pw_uid,account.pw_gid)
    sshconfig = f'Host {name}\n  HostName {ip}\n  User ccdoctor\nHost *\n  IdentityFile {work}/key\n  IdentitiesOnly yes\n  UserKnownHostsFile {work}/known_hosts\n  StrictHostKeyChecking yes\n  BatchMode yes\n  ForwardAgent no\n  ClearAllForwardings yes\n'
    write(work/'ssh_config',sshconfig,account.pw_uid,account.pw_gid)
    instructions = f'''You are repairing {name}. SSH with: ssh -F {work}/ssh_config {name}
The key and provider credentials belong only on this firewall. Never copy secrets to an agent,
print them, upload them, or include them in a transcript. Say what you will do before edits or restarts.
The agent account is ccdoctor with sudo. OpenClaw runs as controlclaw.
Inspect: systemctl status openclaw.service controlclaw-agent; journalctl -u openclaw.service;
/home/controlclaw/.openclaw/openclaw.json; /tmp/openclaw/; df -h; systemctl --failed.
Inspect egress units and /opt/controlclaw/keys/mitm_box_private_ip when network requests fail.
Check disk encryption mounts before touching /opt/controlclaw or the agent home; never write into
an unmounted encrypted directory. Do not change enrollment, firewall pins or doctor authorized_keys.
Before config repairs, back up the config. If doctor is needed, first stop openclaw.service, then run
sudo -u controlclaw -H env NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/controlclaw-mitm.crt openclaw doctor --fix --non-interactive.
Start openclaw.service afterwards and verify it stays active and its gateway answers; inspect its journal.
Never run offline database maintenance with the gateway running. Do not update or reinstall unless needed.
Only this named agent is authorized for repair. Explain the cause, repairs and remaining problems.
'''
    write(work/'AGENTS.md',instructions,account.pw_uid,account.pw_gid)

FIREWALL_INSTRUCTIONS = '''You are repairing this ControlClaw firewall: the box that proxies, filters and resolves for the
organization's agents. You run as ccdoctor without sudo. Your only way to look at or change it is
cc-fwdoctor. Start with: cc-fwdoctor help, then cc-fwdoctor status.
Services: proxy (mitmproxy egress for the agents), dnsmasq (their DNS), caddy (HTTPS for this firewall's
pages and the agents' addresses), tang (unlocks the agents' encrypted disks), disk (this firewall's own
encrypted state), team-chat, chrony. The firewall software itself (mitm-agent) runs this session; you
cannot restart it.
Read a service's logs before restarting it. Check a configuration before restarting caddy or dnsmasq.
A broken rendered configuration is repaired by cc-fwdoctor update-retry, which re-renders every
configuration from the pinned release; it may restart the firewall software, which ends this
session, so say so and use it last. For a full disk, run cc-fwdoctor disk first and clean what is safe.
Never print, copy or ask for secrets. Say what you will do before each restart or clean.
Explain the cause, what you changed and what is still wrong.
'''

def launch(sid,work,mode,seconds,lock):
    args = ['/usr/bin/systemd-run','--quiet','--collect','--unit=cc-doctor-'+sid,
      '--property=User=ccdoctor','--property=Group=ccdoctor','--property=ProtectSystem=strict',
      '--property=ProtectHome=yes','--property=NoNewPrivileges=yes','--property=PrivateTmp=yes',
      '--property=PrivateDevices=yes','--property=ProtectKernelTunables=yes','--property=ProtectControlGroups=yes',
      '--property=RestrictSUIDSGID=yes','--property=CapabilityBoundingSet=',
      '--property=InaccessiblePaths=/opt/controlclaw /root',
      '--property=ReadWritePaths='+str(work), '--property=MemoryMax=2G','--property=TasksMax=256',
      '--property=RuntimeMaxSec='+str(math.ceil(seconds)), '--property=UMask=0077',
      '--property=WorkingDirectory='+str(work),
      '--property=ExecStopPost=+/usr/local/lib/cc-doctor-cleanup '+sid]
    if mode == 'chat': args += ['--pipe','--wait']
    args += ['/usr/local/lib/cc-doctor-worker',sid]
    proc = subprocess.Popen(args)
    for attempt in range(200):
        if subprocess.run(['/usr/bin/systemctl','is-active','--quiet','cc-doctor-'+sid+'.service']).returncode == 0 or proc.poll() is not None: break
        time.sleep(.05)
    else:
        proc.terminate()
        raise ValueError()
    fcntl.flock(lock,fcntl.LOCK_UN)
    os.close(lock)
    code = proc.wait()
    if mode == 'terminal' and code == 0:
        for attempt in range(100):
            if (work/'tmux.sock').exists(): break
            time.sleep(.05)
        else: raise ValueError()
        print(json.dumps({'ready':True,'sessionId':sid}))
    return code
try:
    sys.exit(main())
except Exception:
    print('Doctor runner refused the request',file=sys.stderr)
    sys.exit(1)
